[Unit]
Description=Alert ib_bot DM when daily alt-data QA persistence fails

[Service]
Type=oneshot
User=servidor
# --notify-only is REQUIRED, not optional: without it cmd_api_failure() falls through to
# `await domain_turn(dm, ...)` (conductor/orchestrator/conductor/cli.py:438-448) and runs a FULL
# DM agent turn synchronously inside this unit. A DM turn takes minutes, TimeoutStartSec kills it
# at 120s (SIGTERM, status=15) and the unit lands Result=timeout — an OnFailure alarm that always
# fails. With --notify-only the command returns 0 right after inserting the notify:api_failure
# event (cli.py:434-436); the DM still sees the alert in the notifications feed. Measured on the
# 2026-08-12 00:03:41 WEST negative test: event delivered in 1s, unit then timed out at 00:05:42
# having burned 24.9s CPU / 420MB. Never run an agent turn synchronously from an OnFailure unit.
# This is the sole systemd failure hook for a daily, stateful receipt.  Do not
# coalesce it with a prior synthetic test or an earlier day's failure: doing so
# hid the genuine 2026-08-13 08:00 UTC QA failure.  Systemd invokes OnFailure
# once per failed unit activation, so no cooldown is needed for this path.
ExecStart=/usr/local/bin/conductor api-failure --project ib_bot --service altdata-qa --detail "Daily alt-data QA failed or its git receipt was not persisted" --hint "Inspect journalctl -u ib-altdata-qa.service and reports/altdata_qa_daily.jsonl" --cooldown-min 0 --notify-only
TimeoutStartSec=120
